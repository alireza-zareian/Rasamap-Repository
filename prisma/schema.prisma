// - Billboard.id is an explicit Int so seeded ids stay stable in URLs and the
//   compare tray.
// - Lists and traffic are Json (SQLite has no arrays), validated on the way
//   out in lib/db/billboards/core.ts.
// - Enums are TEXT on SQLite, enforced by the Prisma client. The UI's label
//   maps are typed against them, so a value added here without a label fails
//   the build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Enums ──────────────────────────────────────────────────────

enum BillboardType {
  billboard
  digital
  bridge
  station
  vehicle
}

/// What the media item itself is doing. Describes the board, not the listing.
/// `unknown` is a crawled board: the sources list it but never say whether it
/// is free, so the owner has to be asked (see availabilityFromFeed).
enum Availability {
  available
  busy
  reserved
  inactive
  unknown
}

/// Where a listing is in review. Only `approved` is ever publicly visible.
/// Crawled and admin-created rows start approved; a customer's submission
/// starts at `pending` (or `awaiting_payment` on a paid plan) and moves
/// through POST /api/admin/listings/[id]/decision. `suspended` is a published
/// row that staff took down (POST /api/admin/billboards/[id]/visibility), and
/// only that route puts it back.
enum Moderation {
  pending
  awaiting_payment
  needs_revision
  rejected
  approved
  suspended
}

enum ListingPlan {
  free
  featured
}

enum LeadStatus {
  new
  contacted
  closed
}

enum StaffRole {
  viewer
  editor
  admin
  super_admin
}

enum OtpPurpose {
  password_reset
  register
}

enum AuditSeverity {
  info
  warn
  critical
}

enum SessionKind {
  customer
  staff
}

enum TombstoneReason {
  dedupe
  admin_delete
  first_sync
}

// ── User ───────────────────────────────────────────────────────
// A customer account. Customers submit media for listing, write reviews and
// ask for owners' numbers; buying advertising space happens off-platform,
// directly with the media owner. Staff are a separate kind of account
// (`Admin`) — see lib/db/staff.ts for why.
model User {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())

  sessions        Session[]
  listings        Billboard[]
  reviews         Review[]
  reviewReplies   ReviewReply[]
  contactRequests ContactRequest[]
  auditLogs       AuditLog[]

  @@map("users")
}

// ── Admin ──────────────────────────────────────────────────────
// A staff account. `ADMIN_EMAIL` is upserted here by the seed as the first
// super_admin, so every staff session names a real row.
model Admin {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  passwordHash   String
  name           String
  role           StaffRole @default(viewer)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  sessions      Session[]
  auditLogs     AuditLog[]
  reviewReplies ReviewReply[]

  @@map("admins")
}

// ── Billboard ──────────────────────────────────────────────────
// One outdoor media item, however it arrived: curated in lib/data.ts, crawled
// (see BillboardSource), created in the admin panel, or submitted by a
// customer through /list-media.
model Billboard {
  id       Int           @id @default(autoincrement())
  name     String
  slug     String        @unique
  location String
  region   String
  city     String
  type     BillboardType

  // Two questions that were once one `status` column: is the board free, and
  // has the listing passed review. Together, editing availability could skip
  // review.
  availability Availability @default(available)
  moderation   Moderation   @default(approved)

  width  Int
  height Int
  faces  Int
  age    Int

  // Denormalised width * height, for the "largest surface" sort — Prisma cannot
  // ORDER BY an expression. Recomputed by every write that changes a size.
  area Int @default(0)

  price          Int
  priceWeekly    Int
  priceQuarterly Int
  priceYearly    Int

  // TrafficData object ({ daily, peakHour, congestionLevel, pedestrian, estimatedViews, viewabilityScore })
  traffic Json

  // Copy of traffic.estimatedViews, the one JSON field the catalogue sorts on:
  // Prisma cannot ORDER BY a JSON path, nor an index cover one.
  estimatedViews Int @default(0)

  lat Float?
  lng Float?

  // Folded name, city, location and agency for catalogue search
  // (lib/domain/search.ts). Written only by the triggers in migration
  // 20260925160000_add_search_text; Prisma cannot declare a trigger.
  searchText String?

  hasImages       Boolean @default(false)
  images          Json // string[]
  allImages       Json? // string[] | null
  agency          String
  phone           String
  description     String
  features        Json // string[]
  nearbyLandmarks Json // string[]

  // A denormalised summary of the reviews table, recomputed in the same
  // transaction as every review write (lib/db/reviews.ts).
  rating      Float
  reviewCount Int

  // Where the row came from: a crawler's name ("billboardiha", …), "listing",
  // "manual", or null for the curated set. Kept as text because the crawler
  // set is open-ended; the crawler's own bookkeeping is in BillboardSource.
  source String?

  // Set when the row was created through /list-media, so the submitter can see
  // its review status on their dashboard.
  submittedById Int?
  submittedBy   User? @relation(fields: [submittedById], references: [id])

  // An admin's written feedback to the submitter, shown on their dashboard.
  // Required when a submission is rejected or sent back for revision; cleared
  // when the submitter resubmits.
  reviewNote String?

  // Monetisation. `plan` is what the submitter asked for; `featured` is what an
  // admin actually granted after confirming payment. Keeping them apart means a
  // requested-but-unpaid plan can never promote a listing on its own.
  plan     ListingPlan @default(free)
  featured Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRecord    BillboardSource?
  reviews         Review[]
  contactRequests ContactRequest[]

  @@index([city])
  @@index([type])
  @@index([moderation, availability])
  @@index([price])
  @@index([submittedById])
  // A partial unique index on (submittedById, name, city) WHERE source='listing'
  // also exists — see migration 20260902140000_listing_submit_unique. Prisma
  // cannot express a partial index, so it is raw SQL and is not repeated here.
  @@index([hasImages])
  @@index([featured, hasImages, price])
  @@index([hasImages, price])
  @@index([hasImages, estimatedViews])
  @@index([hasImages, area])
  @@index([city, moderation])
  @@index([city, type])
  @@index([type, price])
  @@index([lat, lng])
  @@map("billboards")
}

// ── BillboardSource ────────────────────────────────────────────
// A crawled row's provenance and what prisma/sync-scraped.ts needs to merge
// the feed into it. Listings and admin-created rows have none.
model BillboardSource {
  billboardId Int       @id
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)

  url           String?
  structureCode String?
  scrapedAt     String?

  // What the source last said, field by field: a column still equal to it is
  // the source's to update; one that drifted was edited by an admin. Null
  // until the first sync.
  snapshot Json?

  // When the row stopped appearing in the source feed. A vanished listing is
  // marked, never deleted — reviews, contact requests and admin edits hang off
  // it. Cleared if it comes back.
  missingSince DateTime?

  @@map("billboard_sources")
}

// ── SourceTombstone ────────────────────────────────────────────
// A crawler row this database deliberately does not have (merged by
// db:dedupe, deleted by an admin), so the import never re-inserts it.
model SourceTombstone {
  slug      String          @id
  reason    TombstoneReason
  note      String?
  createdAt DateTime        @default(now())

  @@map("source_tombstones")
}

// No Reservation model by design. Rasamap is a directory: it does not own the
// media it lists and cannot sell inventory it does not control, so buyers are
// handed the owner's phone number instead of a checkout. Revenue comes from the
// listing side (see Billboard.plan).

// One row per Idempotency-Key seen on a non-idempotent POST. A repeated key
// returns the stored response instead of creating a second record.
model IdempotencyKey {
  key        String   @id
  userId     Int
  endpoint   String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("idempotency_keys")
}

// ── Review ─────────────────────────────────────────────────────
// Any signed-in customer may post; the unique constraint below is what keeps
// one account from inflating a rating.
model Review {
  id          Int       @id @default(autoincrement())
  billboardId Int
  billboard   Billboard @relation(fields: [billboardId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  rating  Int // 1–5
  comment String

  createdAt DateTime @default(now())

  replies ReviewReply[]

  @@unique([billboardId, userId])
  @@index([billboardId])
  @@map("reviews")
}

// ── ReviewReply ────────────────────────────────────────────────
// A reply under a review, one level deep. Its author is a customer (`userId`)
// or a staff member (`staffId`); `authorName` is their name when it was written.
model ReviewReply {
  id       Int    @id @default(autoincrement())
  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId  Int?
  user    User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId Int?
  staff   Admin? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  authorName String
  isStaff    Boolean @default(false)
  body       String

  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
  @@index([userId])
  @@index([staffId])
  @@map("review_replies")
}

// ── ContactRequest ─────────────────────────────────────────────
// A lead: a signed-in customer revealed an owner's phone — the last step the
// platform sees, since the deal happens off it (§17). One row per (media,
// account); a repeat bumps `count`, and the unique index makes the
// get-or-create safe under concurrent clicks.
model ContactRequest {
  id          Int       @id @default(autoincrement())
  billboardId Int
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Follow-up state, moved by staff: new → contacted → closed. `note` is an
  // internal memo — it is never shown to the customer who made the request.
  status LeadStatus @default(new)
  note   String?

  count           Int      @default(1)
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([billboardId, userId])
  @@index([status, lastRequestedAt])
  @@index([billboardId])
  @@index([userId])
  @@map("contact_requests")
}

// ── OtpCode ────────────────────────────────────────────────────
// One-time codes for phone-verified flows (sign-up, password reset). The code
// itself is never stored — only an HMAC-SHA256 hash. Short-lived, single-use,
// attempt-capped. Consumed rows are kept briefly then pruned opportunistically.
model OtpCode {
  id         Int        @id @default(autoincrement())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ── AuditLog ───────────────────────────────────────────────────
// The durable half of lib/audit.ts. The actor is a real foreign key into
// whichever table it belongs to — `adminId` for staff, `userId` for a
// customer — or neither, for an anonymous event such as a lockout.
// `userEmail` keeps a staff actor's address as it was, for display after the
// account is gone. Pruned opportunistically past 90 days.
model AuditLog {
  id        Int           @id @default(autoincrement())
  timestamp DateTime      @default(now())
  action    String // AuditAction, e.g. login_success | billboard_update | ...
  severity  AuditSeverity

  adminId   Int?
  admin     Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  ip        String?
  userAgent String?
  details   Json?

  @@index([adminId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ── Session ────────────────────────────────────────────────────
// One signed-in browser. The cookie holds a random token, this row its
// SHA-256, so a copy of the database is not a set of working sessions.
// Signing out deletes the row; a new password, a reset or a deactivation
// deletes all of an account's rows. One of `userId`/`adminId` is set, per
// `kind`. Lifetimes: lib/db/sessions.ts.
model Session {
  id        String      @id
  kind      SessionKind
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   Int?
  admin     Admin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  // When the person signed in — the start of the absolute lifetime.
  createdAt DateTime    @default(now())
  // The idle limit, pushed forward while the session is in use.
  expiresAt DateTime

  @@index([userId])
  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}
