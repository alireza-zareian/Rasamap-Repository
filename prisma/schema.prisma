// RASAMAP — Prisma Schema
//
// Notes on deliberate choices:
// - Billboard.id: explicit Int PK so seeded numeric ids are preserved —
//   RealMap.tsx, CompareBar, and detail routes depend on stable ids.
// - Arrays (images, allImages, features, nearbyLandmarks) and TrafficData
//   are stored as Json — SQLite has no native array type.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Owner ──────────────────────────────────────────────────────
model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  company   String?
  createdAt DateTime @default(now())

  billboards Billboard[]

  @@map("owners")
}

// ── User ───────────────────────────────────────────────────────
// A registered account. Users submit media for listing and write reviews;
// buying advertising space happens off-platform, directly with the media owner.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  listings Billboard[]
  reviews  Review[]

  @@map("users")
}

// ── Admin ──────────────────────────────────────────────────────
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("viewer") // viewer | editor | admin | super_admin
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]

  @@map("admins")
}

// ── Billboard ──────────────────────────────────────────────────
// Field-for-field mirror of the Billboard interface in lib/data.ts.
model Billboard {
  id      Int     @id @default(autoincrement())
  name    String
  slug    String  @unique
  location String
  region   String
  city     String
  type     String // BillboardType: billboard | digital | bridge | station | vehicle
  // BillboardStatus. Two values belong to the submission pipeline rather than to
  // the media itself:
  //   pending          — submitted via /list-media, awaiting admin review
  //   awaiting_payment — reviewed, waiting for the owner to settle a paid plan
  // the rest describe a published item: available | busy | reserved | inactive.
  // Only published items are returned by a public read (see getPublicWhere()).
  status   String

  width  Int
  height Int
  faces  Int
  age    Int

  // Denormalised width * height, for the "largest surface" sort — Prisma cannot
  // ORDER BY an expression. Recomputed by updateBillboard() on any size change.
  area Int @default(0)

  price          Int
  priceWeekly    Int
  priceQuarterly Int
  priceYearly    Int

  // TrafficData object ({ daily, peakHour, congestionLevel, pedestrian, estimatedViews, viewabilityScore })
  traffic Json

  // Denormalised copy of traffic.estimatedViews. SQLite can read a JSON path
  // (json_extract) but Prisma cannot ORDER BY one and an index cannot cover it,
  // so the single field the catalogue sorts on ("بیشترین بازدید") is kept in its
  // own indexed column. Written by the seed and by newBillboardDefaults().
  estimatedViews Int @default(0)

  mapX Float
  mapY Float
  lat  Float?
  lng  Float?

  icon        String
  hasImages   Boolean @default(false)
  images      Json // string[]
  allImages   Json? // string[] | null
  agency      String
  phone       String
  description String
  features         Json // string[]
  nearbyLandmarks  Json // string[]
  rating      Float
  reviewCount Int

  // Scraper-specific (optional — absent on static/legacy records)
  url           String?
  source        String?
  structureCode String?
  scrapedAt     String?

  ownerId Int?
  owner   Owner? @relation(fields: [ownerId], references: [id])

  // Set when the row was created through /list-media, so the submitter can see
  // its review status on their dashboard. Null for scraped and admin-created
  // rows, which have no submitting account.
  submittedById Int?
  submittedBy   User? @relation(fields: [submittedById], references: [id])

  // Monetisation. `plan` is what the submitter asked for; `featured` is what an
  // admin actually granted after confirming payment. Keeping them apart means a
  // requested-but-unpaid plan can never promote a listing on its own.
  plan     String  @default("free") // free | featured
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([price])
  @@index([ownerId])
  @@index([submittedById])
  @@index([hasImages])
  @@index([featured, hasImages, price])
  @@index([hasImages, price])
  @@index([hasImages, estimatedViews])
  @@index([hasImages, area])
  @@index([city, status])
  @@index([city, type])
  @@index([type, price])
  @@map("billboards")
}

// No Reservation model by design. Rasamap is a directory: it does not own the
// media it lists and cannot sell inventory it does not control, so buyers are
// handed the owner's phone number instead of a checkout. Revenue comes from the
// listing side (see Billboard.plan). Removed in the 2026-09-02 review.

// One row per Idempotency-Key seen on a non-idempotent POST. A repeated key
// returns the stored response instead of creating a second record.
model IdempotencyKey {
  key        String   @id
  userId     Int
  endpoint   String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("idempotency_keys")
}

// ── Review ─────────────────────────────────────────────────────
// Any signed-in user may post; the unique constraint below is what keeps one
// account from inflating a rating. (Before the 2026-09-02 review this required
// a confirmed reservation — with booking gone there is no purchase record to
// verify against, so the honest rule is one review per account per media.)
model Review {
  id          Int       @id @default(autoincrement())
  billboardId Int
  billboard   Billboard @relation(fields: [billboardId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  rating  Int    // 1–5
  comment String

  createdAt DateTime @default(now())

  @@unique([billboardId, userId])
  @@index([billboardId])
  @@map("reviews")
}

// ── OtpCode ────────────────────────────────────────────────────
// One-time codes for phone-verified flows (password reset). The code itself is
// never stored — only an HMAC-SHA256 hash. Short-lived, single-use, attempt-
// capped. Consumed rows are kept briefly for audit then pruned opportunistically.
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  purpose    String // "password_reset"
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ── AuditLog ───────────────────────────────────────────────────
// In-memory ring buffer in lib/auth/audit.ts; DB table reserved for
// future persistence.
model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  action    String // AuditAction, e.g. login_success | billboard_update | ...
  severity  String // info | warn | critical

  adminId   Int?
  admin     Admin?  @relation(fields: [adminId], references: [id])
  userEmail String?
  ip        String?
  userAgent String?
  details   Json?

  @@index([adminId])
  @@map("audit_logs")
}
