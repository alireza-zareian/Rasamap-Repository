{
  "name": "rasamap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.mjs",
    "demo": "next build && node server.mjs",
    "lint": "eslint",
    "test": "node test/run.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/unit/",
    "test:seed": "node test/seed.mjs",
    "test:reset": "node test/reset-db.mjs",
    "bench": "node test/bench.mjs",
    "db:backup": "sh scripts/backup-db.sh",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo-full.ts",
    "db:dedupe": "tsx prisma/dedupe-billboards.ts",
    "db:reset-coords": "tsx prisma/reset-coordinates.ts",
    "db:export-unresolved": "tsx prisma/export-unresolved.ts",
    "db:backfill-coords": "tsx prisma/backfill-coordinates.ts",
    "db:sync-scraped": "tsx prisma/sync-scraped.ts",
    "db:studio": "prisma studio",
    "images:variants": "python3 scripts/build-image-variants.py",
    "images:check": "node scripts/check-images.mjs",
    "db:to-postgres": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/to-postgres.mjs",
    "db:to-sqlite": "node scripts/to-postgres.mjs --to-sqlite",
    "test:e2e": "node test/run-e2e.mjs",
    "bundle": "node scripts/bundle-report.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.34.0",
    "next": "^16.2.11",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.1",
    "server-only": "^0.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
