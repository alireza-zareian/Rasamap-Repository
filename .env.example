# ── Rasamap — environment variables (names only, no real values) ──
# Copy this file to `.env.local` and fill in real values.
# `.env*` is git-ignored; never commit real secrets.

# ── Database (Prisma + SQLite) ──
DATABASE_URL="file:./dev.db"

# ── Auth ──
# Random string, min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Admin account (server-side only) ──
# Generate the hash:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync(process.argv[1],12))" 'your-password'
# Keep the hash in double quotes — the leading $2b$ is fine inside "…" in this
# file, but an unquoted value can be mangled by shell / env expansion.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=

# ── Neshan Maps API ──
# NESHAN_API_KEY   — server-side geocoding key (secret)
# NEXT_PUBLIC_NESHAN_KEY — client-side map/tile key (public, safe to expose)
NESHAN_API_KEY=
NEXT_PUBLIC_NESHAN_KEY=

# ── Logging (optional) ──
# LOG_DIR   — if set, every log line (requests, errors, audit) is also appended
#             to <LOG_DIR>/app.log, rotated at 10 MB, 5 backups kept. Leave it
#             empty to log to stdout/stderr only (the terminal running the app).
# LOG_LEVEL — debug | info | warn | error (default: info in production, debug otherwise)
LOG_DIR=
LOG_LEVEL=
