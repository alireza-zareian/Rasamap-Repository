# ── Rasamap — environment variables (names only, no real values) ──
# Copy this file to `.env.local` and fill in real values.
# `.env*` is git-ignored; never commit real secrets.

# ── Database (Prisma + SQLite) ──
DATABASE_URL="file:./dev.db"

# ── Auth ──
# Random string, min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Admin account (server-side only) ──
# Generate the hash:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync(process.argv[1],12))" 'your-password'
# Keep the hash in double quotes — the leading $2b$ is fine inside "…" in this
# file, but an unquoted value can be mangled by shell / env expansion.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=

# ── Neshan Maps API ──
# NESHAN_API_KEY   — server-side geocoding key (secret)
# NEXT_PUBLIC_NESHAN_KEY — client-side map/tile key (public, safe to expose)
NESHAN_API_KEY=
NEXT_PUBLIC_NESHAN_KEY=

# ── Logging (optional) ──
# LOG_DIR   — if set, every log line (requests, errors, audit) is also appended
#             to <LOG_DIR>/app.log, rotated at 10 MB, 5 backups kept. Leave it
#             empty to log to stdout/stderr only (the terminal running the app).
# LOG_LEVEL — debug | info | warn | error (default: info in production, debug otherwise)
LOG_DIR=
LOG_LEVEL=

# ── SMS (Kavenegar) — OFF by default ──
# The whole SMS layer is dormant while KAVENEGAR_API_KEY is empty: registration
# still works, /api/auth/otp/* still respond, and nothing is actually sent.
# Fill the key in to switch it on with no code change (welcome SMS on sign-up +
# the "فراموشی رمز" reset flow start delivering).
#   KAVENEGAR_SENDER        — a dedicated line number, only needed for plain SMS
#   KAVENEGAR_OTP_TEMPLATE  — a verify/lookup template name; if set, OTPs go via
#                             Kavenegar's OTP line (better deliverability, no
#                             sender approval). Leave empty to send OTPs as plain SMS.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
# OTP_DEV_ECHO=1  — return the OTP code in the /api/auth/otp/send response.
#                   LOCAL ONLY: ignored when NODE_ENV=production.
OTP_DEV_ECHO=

# Public address of the deployment. Used for the sitemap and for the absolute
# URLs in social previews. Defaults to https://rasamap.ir when unset.
NEXT_PUBLIC_BASE_URL="https://rasamap.ir"
