# ── Rasamap — environment variables (names only, no real values) ──
# Copy this file to `.env.local` and fill in real values.
# `.env*` is git-ignored; never commit real secrets.

# ── Database ──
# The engine is read from this URL and from nothing else (lib/db/engine.ts):
#   file:./dev.db                              → SQLite   (what the project uses)
#   postgresql://user:pass@host:5432/rasamap   → PostgreSQL
#
# SQLite is the deliberate choice for one process on one machine — §14. The
# PostgreSQL path is built and proven but dormant; moving is one command and
# coming back is another:
#   npm run db:to-postgres -- postgresql://…    (copies and verifies every row)
#   npm run db:to-sqlite                        (switch the schema back)
# See §27 of docs/engineering-decisions.md.
DATABASE_URL="file:./dev.db"

# ── Auth ──
# Random string, min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Admin account (server-side only) ──
# Generate the hash:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync(process.argv[1],12))" 'your-password'
# Keep the hash in double quotes — the leading $2b$ is fine inside "…" in this
# file, but an unquoted value can be mangled by shell / env expansion.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=

# ── Neshan geocoding — OPTIONAL, and not used by the running app ──
# Read only by `npm run db:backfill-coords` (prisma/backfill-coordinates.ts),
# which fills in missing latitude/longitude offline. The site serves fine
# without it. There is no client-side map any more, so the public key that used
# to sit here is gone (§29).
NESHAN_API_KEY=

# ── Logging (optional) ──
# LOG_DIR   — if set, every log line (requests, errors, audit) is also appended
#             to <LOG_DIR>/app.log, rotated at 10 MB, 5 backups kept. Leave it
#             empty to log to stdout/stderr only (the terminal running the app).
# LOG_LEVEL — debug | info | warn | error (default: info in production, debug otherwise)
LOG_DIR=
LOG_LEVEL=

# ── SMS (Kavenegar) — OFF by default ──
# The whole SMS layer is dormant while KAVENEGAR_API_KEY is empty: registration
# still works, /api/auth/otp/* still respond, and nothing is actually sent.
# Fill the key in to switch it on with no code change (welcome SMS on sign-up +
# the "فراموشی رمز" reset flow start delivering).
#   KAVENEGAR_SENDER        — a dedicated line number, only needed for plain SMS
#   KAVENEGAR_OTP_TEMPLATE  — a verify/lookup template name; if set, OTPs go via
#                             Kavenegar's OTP line (better deliverability, no
#                             sender approval). Leave empty to send OTPs as plain SMS.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
# OTP_DEV_ECHO=1  — show the OTP code on screen (in the /api/auth/otp/send
#                   response) while KAVENEGAR_API_KEY is empty. This is what
#                   lets sign-up and password reset work on the demo laptop.
#                   Off by itself once SMS is configured. NEVER on a public
#                   server without SMS: anyone could reset any password.
OTP_DEV_ECHO=

# ── Reverse proxy in front of the app ──
#
# How many proxies sit between the internet and this process. nginx alone = 1,
# Cloudflare in front of nginx = 2. Default is 1.
#
# This is not a tuning knob — it decides whether the client address can be
# trusted at all. Each proxy APPENDS the address it really saw to
# X-Forwarded-For, so reading the entry this many positions from the right
# skips over anything the caller forged.
#
# With NO proxy (0), the address is the TCP peer, which server.mjs — what
# `npm start` and `npm run demo` run — stamps on every request in a header a
# client cannot set. Under plain `next start` that header is absent and the
# address falls back to X-Forwarded-For, which a caller can forge.
#
# The `npm run demo` laptop is the one case with no proxy in front — .env
# overrides this to 0 for exactly that reason. A public server should still
# sit behind the nginx config in deploy/ (TLS, buffering, limits).
TRUSTED_PROXY_COUNT=1

# The interface server.mjs listens on. Empty = every interface, which the demo
# laptop needs (a phone on the same Wi-Fi). Behind nginx set 127.0.0.1, so the
# proxy is the only way in (deploy/rasamap.service does).
BIND_ADDRESS=

# ── Shared cache (Redis) — OFF by default ──
# Empty: Next.js caches rendered pages and catalogue queries in .next/cache —
# correct for a single process on one machine, which is the demo laptop.
#
# Set it once the site runs as more than one instance (two containers, a
# restart-on-deploy setup, several machines behind a load balancer). Then all of
# them share one store: an entry written by one is read by all, an admin's edit
# invalidates it everywhere at once, and a redeploy does not start cold.
# Nothing in the code changes — see cache-handler.js and §25 of
# docs/engineering-decisions.md.
#
# Measured trade-off on one machine: it makes the landing page slower
# (2.2 ms → 3.4 ms CPU per visit), because a page that was handed over from
# memory now also talks to Redis. Leave it empty until there really is a second
# instance to keep in step.
#
#   REDIS_URL     — e.g. redis://127.0.0.1:6379 (or redis://user:pass@host:6379/0)
#   REDIS_PREFIX  — key prefix, so one Redis can host several apps.
#                   Defaults to "rasamap:cache:".
REDIS_URL=
REDIS_PREFIX=

# Public address of the deployment. Used for the sitemap and for the absolute
# URLs in social previews. Defaults to https://rasamap.ir when unset.
NEXT_PUBLIC_BASE_URL="https://rasamap.ir"
